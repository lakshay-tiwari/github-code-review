# ==============================================================================
# CORTEX — Environment Variables Template
# Copy this file to .env: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME=cortex-api
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------------------------
# Infrastructure Services (Local Docker Compose)
# ------------------------------------------------------------------------------
# PostgreSQL
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_password
POSTGRES_DB=cortex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cortex:cortex_dev_password@localhost:5432/cortex

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_DEFAULT_QUEUE=cortex_default

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=cortex_code_chunks
# QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false

# Neo4j Graph Database
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cortex_dev_password
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ------------------------------------------------------------------------------
# API Backend (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Web Frontend (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Authentication (Clerk - Phase 2 & 3B)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_c3R1bm5pbmctYm9iY2F0LTQxLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Server-Side Token Verification (FastAPI)
# Issuer URL: defaults to derived domain from publishable key (https://stunning-bobcat-41.clerk.accounts.dev)
CLERK_ISSUER=https://stunning-bobcat-41.clerk.accounts.dev
# JWKS URL: defaults to {CLERK_ISSUER}/.well-known/jwks.json
CLERK_JWKS_URL=https://stunning-bobcat-41.clerk.accounts.dev/.well-known/jwks.json
# Optional authorized party (azp) validation (e.g. frontend origin)
CLERK_AUTHORIZED_PARTY=http://localhost:3000
# Optional custom audience check (if Clerk JWT Template defines aud)
# CLERK_AUDIENCE=cortex-api
# Optional direct RSA PEM public key (for offline or air-gapped testing)
# CLERK_PEM_PUBLIC_KEY=


# ------------------------------------------------------------------------------
# LLM & Embedding Providers (Phase 3C)
# ------------------------------------------------------------------------------
# Primary Chat LLM Provider ('groq')
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Embedding Provider ('sentence-transformers')
# Fixed 384-dimensional dense vectors using local CPU/GPU weights
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Opt-in live smoke tests for CI / manual validation
# RUN_LIVE_GROQ_TESTS=false


# ------------------------------------------------------------------------------
# Optional LangSmith Tracing (Phase 7)
# ------------------------------------------------------------------------------
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_placeholder
# LANGSMITH_PROJECT=cortex
