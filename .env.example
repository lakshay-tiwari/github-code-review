# ==============================================================================
# CORTEX — Environment Variables Template
# Copy this file to .env: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME=cortex-api
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------------------------
# Infrastructure Services (Local Docker Compose)
# ------------------------------------------------------------------------------
# PostgreSQL
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_password
POSTGRES_DB=cortex
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cortex:cortex_dev_password@localhost:5432/cortex

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Neo4j Graph Database
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cortex_dev_password
NEO4J_URI=bolt://localhost:7687

# ------------------------------------------------------------------------------
# API Backend (FastAPI)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Web Frontend (Next.js)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
FASTAPI_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Authentication (Clerk - Phase 2)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ------------------------------------------------------------------------------
# LLM & Embedding Providers (Phase 3+)
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_placeholder
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# Optional LangSmith Tracing (Phase 7)
# ------------------------------------------------------------------------------
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_placeholder
# LANGSMITH_PROJECT=cortex
